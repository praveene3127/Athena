# Athena Backend Environment Configuration Example
# Copy this file to .env and fill in the values for your deployment.

# Server & Paths
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Ingestion Constraints (§Stage-0 & §4 in CLAUDE.md)
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_PAGE_COUNT=3000
MIN_PROSE_WORDS=350
MIN_SENTENCE_COUNT=6

# AI & Key Failover (§3 in CLAUDE.md)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-3.8-flash

# Proxy Token for mobile and web excerpts (Header: X-Athena-Context-Token)
ATHENA_CONTEXT_PROXY_TOKEN=

# Wikipedia API Contact Header (§3 in Blueprint)
WIKI_CONTACT=athena-reader@example.com

# Timeout for Vibe Check inference
VIBE_CHECK_TIMEOUT_S=4.5
