<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Permit cleartext traffic for local Wi-Fi LAN pairing (192.168.x.x, 10.x.x.x, *.local) -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
